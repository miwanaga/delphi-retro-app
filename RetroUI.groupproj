<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{E7ACA44D-ACEA-4928-8795-A3A8298C90E1}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="RetroUI_org\RetroUIProject.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="RetroUIFull\RetroUIFull.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="RetroUID13\RetroUID13.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="RetroUIProject">
        <MSBuild Projects="RetroUI_org\RetroUIProject.dproj"/>
    </Target>
    <Target Name="RetroUIProject:Clean">
        <MSBuild Projects="RetroUI_org\RetroUIProject.dproj" Targets="Clean"/>
    </Target>
    <Target Name="RetroUIProject:Make">
        <MSBuild Projects="RetroUI_org\RetroUIProject.dproj" Targets="Make"/>
    </Target>
    <Target Name="RetroUIFull">
        <MSBuild Projects="RetroUIFull\RetroUIFull.dproj"/>
    </Target>
    <Target Name="RetroUIFull:Clean">
        <MSBuild Projects="RetroUIFull\RetroUIFull.dproj" Targets="Clean"/>
    </Target>
    <Target Name="RetroUIFull:Make">
        <MSBuild Projects="RetroUIFull\RetroUIFull.dproj" Targets="Make"/>
    </Target>
    <Target Name="RetroUID13">
        <MSBuild Projects="RetroUID13\RetroUID13.dproj"/>
    </Target>
    <Target Name="RetroUID13:Clean">
        <MSBuild Projects="RetroUID13\RetroUID13.dproj" Targets="Clean"/>
    </Target>
    <Target Name="RetroUID13:Make">
        <MSBuild Projects="RetroUID13\RetroUID13.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="RetroUIProject;RetroUIFull;RetroUID13"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="RetroUIProject:Clean;RetroUIFull:Clean;RetroUID13:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="RetroUIProject:Make;RetroUIFull:Make;RetroUID13:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
